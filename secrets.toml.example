# Modelo de secrets para o deploy no Streamlit Community Cloud.
#
# Para uso local: renomeie este arquivo para "secrets.toml" e coloque-o dentro
# de uma pasta ".streamlit" na raiz do projeto (".streamlit/secrets.toml").
# Para o deploy: cole este conteúdo (com os valores reais) em
# "Settings" > "Secrets" do seu app em https://share.streamlit.io
#
# Nunca faça commit de um secrets.toml com valores reais.

DATABASE_URL = "postgresql://postgres.SEUPROJETO:SUASENHA@aws-x-region.pooler.supabase.com:6543/postgres"
